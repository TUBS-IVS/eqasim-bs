# Python cache files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
env/
venv/
.venv/
ENV/

# Local IDE settings
.vscode/
.idea/

# Local caches
cache/
**/cache/
.cache/
**/.cache/

# Local outputs
output/
**/output/

# Local pipeline data
data/nantes_2015/
data/lyon_2015/

# Local configuration files
config_local_*.yml

# Track Braunschweig configs explicitly because they are versioned project artefacts.
!config_local_braunschweig.yml
!config_local_braunschweig_10pct.yml
!config_local_braunschweig_25pct.yml

# Coverage and log artefacts
.coverage
*.log
logs/
pipeline_*.log
hh_gap.txt
zensus_hh_inspect.txt


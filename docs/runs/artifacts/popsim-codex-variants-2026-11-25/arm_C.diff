+def _draw_household_ids(group_ids, household_groups, household_id_col, rng):
+    """Draw one donor per row in the same order as weighted RandomState.choice."""
+    donor_ids = household_groups[household_id_col].to_numpy()
+    sample_weights = household_groups["sample_weight"].to_numpy()
+    donors = household_groups.groupby("group_id", sort=False).indices
+
+    # Draw in geographic order first, so batching by group preserves the stream
+    # even for groups that recur in different zones or have only one donor.
+    uniforms = rng.random_sample(len(group_ids))
+    chosen = np.empty(len(group_ids), dtype=donor_ids.dtype)
+    draw_positions = group_ids.groupby(group_ids, sort=False, dropna=False).indices
+    for group_id, positions in draw_positions.items():
+        members = donors[group_id]
+        weights = sample_weights[members]
+        total = weights.sum()
+        if not np.isfinite(total) or total <= 0 or (weights < 0).any():
+            raise ValueError(f"Invalid sample weights in household group {group_id}")
+
+        # RandomState.choice normalizes the cumulative probabilities in float64.
+        cdf = np.cumsum(weights / total, dtype=np.float64)
+        cdf /= cdf[-1]
+        offsets = np.searchsorted(cdf, uniforms[positions], side="right")
+        chosen[positions] = donor_ids[members[offsets]]
+
+    return chosen
+
+
